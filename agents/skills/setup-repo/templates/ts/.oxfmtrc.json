{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    ".devenv/**",
    ".direnv/**",
    "dist/**",
    "tools/oxlint/anti-slop/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".opencode/**",
    ".pi/**"
  ]
}
