@@ -807,6 +807,13 @@ class GatewayConfig:
             return choice
         return "ignore" if platform == Platform.EMAIL else self.unauthorized_dm_behavior
 
+    def get_unauthorized_dm_owner_notifications(self, platform: Optional[Platform] = None) -> bool:
+        """Whether ignored unauthorized DMs notify the owner in the platform home channel."""
+        platform_cfg = self.platforms.get(platform) if platform else None
+        if not platform_cfg or "unauthorized_dm_owner_notifications" not in platform_cfg.extra:
+            return True
+        return _coerce_bool(platform_cfg.extra.get("unauthorized_dm_owner_notifications"), default=True)
+
     def get_notice_delivery(self, platform: Optional[Platform] = None) -> str:
         """Effective notice-delivery mode ("public"/"private") for a platform."""
         choice = self._extra_choice(platform, "notice_delivery", {"public", "private"}, "public")
